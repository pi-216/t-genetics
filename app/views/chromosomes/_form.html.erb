<%# Issue #133 — shared chromosome form: FormField + kit button, hairline
    inputs, cardinality handled by the caller's model. %>
<%# Finding #147 (T1) — same Turbo transport fix as the designer form: the
    PATCH failure re-render (422) must display inline errors in a real
    browser. %>
<%= form_with(model: chromosome, data: { turbo: false }) do |form| %>
  <div class="max-w-[36rem]">
    <%= render FormFieldComponent.new(input_id: 'chromosome_name', label: 'Name', required: true,
                                      errors: chromosome.errors[:name]) do %>
      <%= form.text_field :name, autocomplete: 'off', class: FormFieldComponent::INPUT_CLASSES %>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%= render ButtonComponent.new(label: 'Save chromosome', type: :submit, name: 'commit',
                                     value: 'Save chromosome', variant: :primary) %>
      <%= render ButtonComponent.new(label: 'Cancel', href: chromosome, variant: :ghost) %>
    </div>
  </div>
<% end %>
