<%# Issue #184 — PO ruling 2026-09-15: standard CRUD. The allele form is
    type-aware: a type select (new) or read-only type label (edit), plus name
    and the fields the selected type constrains. Issue #206 — each type's
    constraint fields live in their own partial (AllelesHelper::FIELD_GROUPS);
    every group renders so the Stimulus toggle can reveal the selected type's
    fields in a real browser, and the server is the source of truth regardless
    (only the selected type's fields validate). Field ids match the machine
    contract param names (allele[name], allele[minimum], ...) so one
    strong-params shape serves web + JSON. %>
<%# Finding #147 (T1) — the 422 re-render must display in a real browser:
    opt out of Turbo exactly like the other re-rendering forms. %>
<%= form_with(model: allele, url: form_url, method: form_method, data: { turbo: false }) do |form| %>
  <div class="max-w-[36rem]">
    <div data-controller="allele-type-fields">
      <%= render FormFieldComponent.new(input_id: 'allele_type', label: 'Type', required: true,
                                        errors: field_errors(allele, :type)) do %>
        <% if editable_type %>
          <select id="allele_type" name="allele[type]" data-allele-type-select
                  class="<%= FormFieldComponent::INPUT_CLASSES %>">
            <% %w[Float Integer Boolean Option].each do |type| %>
              <option value="<%= type %>" <%= 'selected' if allele.type == type %>><%= type %></option>
            <% end %>
          </select>
        <% else %>
          <p id="allele_type" class="rounded border border-line bg-surface px-3 py-2.5 font-data text-sm text-inkMuted">
            <%= allele.type %>
          </p>
        <% end %>
      <% end %>

      <%= render FormFieldComponent.new(input_id: 'allele_name', label: 'Name', required: true,
                                        errors: field_errors(allele, :name)) do %>
        <input id="allele_name" name="allele[name]" type="text" value="<%= allele.name %>"
               autocomplete="off" class="<%= FormFieldComponent::INPUT_CLASSES %>">
      <% end %>

      <% allele_field_groups(allele).each do |group| %>
        <%= render group[:partial], allele: allele, active: group[:active] %>
      <% end %>
    </div>

    <% if allele.errors[:base].any? || allele.inheritable&.errors&.any? %>
      <div class="command-errors mb-4 rounded-md border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger">
        <% (allele.errors[:base] + Array(allele.inheritable&.errors&.full_messages)).uniq.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%= render ButtonComponent.new(label: submit_label, type: :submit, variant: :primary) %>
      <%= render ButtonComponent.new(label: 'Cancel', href: chromosome_path(chromosome), variant: :ghost) %>
    </div>
  </div>
<% end %>
