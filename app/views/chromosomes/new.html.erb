<%# Issue #133 — the chromosome designer: a single surface for building a
    chromosome from typed allele cards with a live preview. "Add allele"
    posts back (commit=Add allele) to re-render with one more blank card,
    preserving entered cards — server-rendered, no JS dependency. The final
    submit runs Chromosomes::Create (PRD-0004 red line: designer mutations
    go through commands, never direct model writes). %>
<%# Issue #141 — the allele cards render their fields through the kit
    (FormFieldComponent + INPUT_CLASSES) instead of hand-rolled label/input
    markup, so the designer inherits the label→input rhythm and touch-reach
    padding of every other internal form surface at 480px. Field ids, names,
    and label text are unchanged (the request/BDD wire contract). %>
<%= render PageHeaderComponent.new(title: 'Design chromosome',
                                   kicker: 'Chromosome',
                                   back_path: chromosomes_path,
                                   back_label: 'Chromosomes') %>

<% if @chromosome.errors.any? %>
  <div class="command-errors mb-4 rounded-md border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger">
    <ul class="list-disc space-y-1 pl-5">
      <% @chromosome.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# Finding #148 (T2) — the @javascript acceptance walk changes a card's type
    via the Add-allele round trip in a real browser; that re-render (200, no
    redirect) is discarded by Turbo's form interception (finding #147's
    transport bug, live-walk observed: "the page never grows past Allele 1").
    data-turbo="false" opts THIS form out so the round trip renders — the
    minimum #148's own browser AC requires; the whole-class transport fix
    (edit/experiments/loop forms, ButtonComponent) stays tracked by #147. %>
<%= form_with(model: @chromosome, data: { turbo: false }) do |form| %>
  <div class="max-w-xl">
    <%= render FormFieldComponent.new(input_id: 'chromosome_name', label: 'Name', required: true) do %>
      <%= form.text_field :name, autocomplete: 'off', class: FormFieldComponent::INPUT_CLASSES %>
    <% end %>
  </div>

  <div class="allele-cards mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <% @allele_cards.each_with_index do |card, index| %>
      <%= render CardComponent.new(title: "Allele #{index + 1}") do %>
        <div class="allele-card space-y-3">
          <%= render FormFieldComponent.new(input_id: "allele-#{index}-type", label: 'Type') do %>
            <select id="allele-<%= index %>-type" name="chromosome[alleles][][type]"
                    class="<%= FormFieldComponent::INPUT_CLASSES %>">
              <% %w[Float Integer Boolean Option].each do |type| %>
                <option value="<%= type %>" <%= 'selected' if card[:type] == type %>><%= type %></option>
              <% end %>
            </select>
          <% end %>

          <%= render FormFieldComponent.new(input_id: "allele-#{index}-name", label: 'Allele name') do %>
            <input id="allele-<%= index %>-name" name="chromosome[alleles][][name]"
                   type="text" value="<%= card[:name] %>" autocomplete="off"
                   class="<%= FormFieldComponent::INPUT_CLASSES %>">
          <% end %>

          <%# Finding #148 (T2) — type-aware field set: Float/Integer cards
              render minimum + maximum, Option cards render choices, Boolean
              renders name only. The allele models are the single source of
              truth (Alleles::Float/Integer/Boolean/Option); a card must not
              advertise fields the type has no constraints for. %>
          <% if %w[Float Integer].include?(card[:type]) %>
            <%= render FormFieldComponent.new(input_id: "allele-#{index}-minimum", label: 'Minimum') do %>
              <input id="allele-<%= index %>-minimum" name="chromosome[alleles][][minimum]"
                     type="number" step="any" value="<%= card[:minimum] %>" autocomplete="off"
                     class="<%= FormFieldComponent::INPUT_CLASSES %>">
            <% end %>

            <%= render FormFieldComponent.new(input_id: "allele-#{index}-maximum", label: 'Maximum') do %>
              <input id="allele-<%= index %>-maximum" name="chromosome[alleles][][maximum]"
                     type="number" step="any" value="<%= card[:maximum] %>" autocomplete="off"
                     class="<%= FormFieldComponent::INPUT_CLASSES %>">
            <% end %>
          <% elsif card[:type] == 'Option' %>
            <%= render FormFieldComponent.new(input_id: "allele-#{index}-choices", label: 'Choices') do %>
              <input id="allele-<%= index %>-choices" name="chromosome[alleles][][choices]"
                     type="text" value="<%= Array(card[:choices]).join(', ') %>"
                     placeholder="comma-separated" autocomplete="off"
                     class="<%= FormFieldComponent::INPUT_CLASSES %>">
            <% end %>
          <% end %>

          <%# PRD-0004 DEV-0002 (issue #78): inline per-card validation. The
              command fails with per-allele messages ("allele '<name>': …");
              surface the ones that name this card right under its fields.
              Errors that don't name a card still render in the top-level
              .command-errors summary, so nothing is lost. %>
          <% if card[:name].present? %>
            <% card_errors = @chromosome.errors[:alleles].select { |m| m.include?("allele '#{card[:name]}':") } %>
            <% if card_errors.any? %>
              <div class="allele-error text-sm text-danger">
                <%= card_errors.map { |m| m.sub(/\Aallele '.+?':\s*/, '') }.join('; ') %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <%= render ButtonComponent.new(label: 'Add allele', type: :submit, name: 'commit', value: 'Add allele', variant: :secondary) %>
    <%= render ButtonComponent.new(label: 'Create chromosome', type: :submit, name: 'commit', value: 'Create chromosome', variant: :primary) %>
  </div>
<% end %>

<div class="mt-6">
  <%= render CardComponent.new(title: 'Allele preview',
                               description: 'Live preview — the value space as it will be saved.') do %>
    <%= render 'allele_preview',
               alleles: @allele_cards.reject { |card| card[:name].blank? } %>
  <% end %>
</div>
