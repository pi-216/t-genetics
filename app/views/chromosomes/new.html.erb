<%# Issue #184 — PO ruling 2026-09-15: standard CRUD. The create surface is a
    name-only chromosome; alleles are added afterwards from the show page via
    their own nested forms (never inline on this form). The removal of the
    PRD-0004 designer's inline allele cards is the point of the ruling. %>
<%# Finding #147 (T1) — the 422 re-render of this form must display inline in a
    real browser: opt out of Turbo so the error response renders (same
    transport class as the old designer form). %>
<%= render PageHeaderComponent.new(title: 'Create chromosome',
                                   kicker: 'Chromosome',
                                   back_path: chromosomes_path,
                                   back_label: 'Chromosomes') %>

<%= form_with(model: @chromosome, data: { turbo: false }) do |form| %>
  <div class="max-w-[36rem] space-y-4">
    <%= render FormFieldComponent.new(input_id: 'chromosome_name', label: 'Name', required: true,
                                      errors: @chromosome.errors[:name]) do %>
      <%= form.text_field :name, autocomplete: 'off', class: FormFieldComponent::INPUT_CLASSES %>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%= render ButtonComponent.new(label: 'Create chromosome', type: :submit, variant: :primary) %>
      <%= render ButtonComponent.new(label: 'Cancel', href: chromosomes_path, variant: :ghost) %>
    </div>
  </div>
<% end %>
