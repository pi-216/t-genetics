!!! 5
%html
  %head
    %title T::Genetics
    %meta{ name: :viewport, content: 'width=device-width,initial-scale=1' }
    %meta{ name: 'turbo-refresh-method', content: :morph }
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload'

    = javascript_importmap_tags

  %body.h-full.font-mono.tabular-nums.antialiased.bg-base.text-ink
    %header.flex.items-center.justify-between.border-b.border-line.px-5.py-3
      = link_to 'TGenetics', root_path, class: 'font-data text-sm font-semibold tracking-caption text-ink hover:text-signal'
      %nav.flex.items-center.gap-4.text-sm
        - if user_signed_in?
          = link_to 'Experiments', experiments_path, class: 'font-data text-caption tracking-caption text-inkMuted hover:text-ink'
          = link_to 'Chromosomes', chromosomes_path, class: 'font-data text-caption tracking-caption text-inkMuted hover:text-ink'
          = form_with url: logout_path, method: :post, class: 'inline' do
            = button_tag 'Sign out', type: 'submit', class: 'inline-flex items-center rounded-md border border-line px-3 py-1.5 font-data text-caption tracking-caption text-inkMuted hover:text-ink'
        - else
          = link_to 'Sign in', login_path, class: 'font-data text-caption tracking-caption text-inkMuted hover:text-ink'
    %main.container.mx-auto.mt-10.md:mt-28.px-5
      = yield
    %footer.mt-16.border-t.border-line.py-6.px-5
      %nav.flex.space-x-6.text-sm.text-inkMuted
        = link_to 'Privacy', '#', class: 'hover:text-ink'
        = link_to 'Terms', '#', class: 'hover:text-ink'
