- if resource.errors.any?
  %div{ id: "error_explanation", class: "mb-4 rounded bg-red-900/50 p-3 text-red-200" }
    - resource.errors.full_messages.each do |message|
      %p= message

%h1{ class: "text-2xl font-bold" } Reset your password

= form_with url: user_password_path, class: "mt-8 space-y-4" do |form|
  %div
    = form.label :email, "Email", class: "block text-sm font-medium"
    = form.email_field :email, name: "user[email]", required: true, autofocus: true, class: "mt-1 w-full rounded border border-teal-700 bg-teal-800/50 px-3 py-2 text-teal-100"
  = form.submit "Send me password reset instructions", class: "rounded bg-teal-600 px-4 py-2 font-semibold text-teal-950"