- if resource.errors.any?
  %div{ id: "error_explanation", class: "mb-4 rounded-md border border-danger/30 bg-danger/10 p-3 text-danger" }
    - resource.errors.full_messages.each do |message|
      %p= message

= render PageHeaderComponent.new(title: 'Reset your password',
                                 subtitle: 'We’ll email you a one-time reset link.',
                                 back_path: login_path,
                                 back_label: 'Back to sign in')

= form_with url: user_password_path, class: "mt-6 max-w-md space-y-4" do |form|
  = render FormFieldComponent.new(input_id: 'user_email', label: 'Email', required: true) do
    = form.email_field :email, name: "user[email]", required: true, autofocus: true, class: FormFieldComponent::INPUT_CLASSES
  = render ButtonComponent.new(label: 'Send me password reset instructions', type: :submit, variant: :primary)