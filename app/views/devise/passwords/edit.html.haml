- if resource.errors.any?
  %div{ id: "error_explanation", class: "mb-4 rounded-md border border-danger/30 bg-danger/10 p-3 text-danger" }
    - resource.errors.full_messages.each do |message|
      %p= message

= render PageHeaderComponent.new(title: 'Change your password',
                                 subtitle: 'Set a new password for your account.',
                                 back_path: login_path,
                                 back_label: 'Back to sign in')

= form_with url: user_password_path, method: :patch, class: "mt-6 max-w-md space-y-4" do |form|
  = form.hidden_field :reset_password_token, name: "user[reset_password_token]", value: resource.reset_password_token
  = render FormFieldComponent.new(input_id: 'user_password', label: 'New password', required: true) do
    = form.password_field :password, name: "user[password]", required: true, autofocus: true, class: FormFieldComponent::INPUT_CLASSES
  = render FormFieldComponent.new(input_id: 'user_password_confirmation', label: 'Confirm new password', required: true) do
    = form.password_field :password_confirmation, name: "user[password_confirmation]", required: true, class: FormFieldComponent::INPUT_CLASSES
  = render ButtonComponent.new(label: 'Change my password', type: :submit, variant: :primary)