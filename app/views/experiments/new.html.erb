<h1>New experiment</h1>

<% if @experiment.errors.any? || @command_errors.present? %>
  <div id="error_explanation">
    <h2>Could not create the experiment</h2>
    <ul>
      <% @experiment.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      <% Array(@command_errors).each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @experiment, url: experiments_path) do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <label for="experiment_chromosome_id">Chromosome</label>
    <%= select_tag 'experiment[chromosome_id]', options_from_collection_for_select(@chromosomes, :id, :name) %>
  </div>

  <div>
    <label for="experiment_population_size">Population size</label>
    <%= number_field_tag 'experiment[population_size]', @population_size.presence || 10, min: 1, autocomplete: 'off' %>
  </div>

  <%= form.submit 'Create experiment' %>
<% end %>
