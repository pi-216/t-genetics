<%# Issue #133 — experiment show: the loop instrument panel. Page header with
    the surface's two actions (history link + the single amber request
    action), a configuration card, the suggested-organism card (when a
    suggestion is live), the fitness report form, and the fitness trend.
    Empty generations render the explicit no-suggestion empty state. %>
<%= render PageHeaderComponent.new(title: @experiment.name,
                                   kicker: 'Experiment',
                                   subtitle: "Chromosome: #{@experiment.chromosome.name}") do |header| %>
  <% header.with_actions do %>
    <%= render ButtonComponent.new(label: 'Generation history', href: history_experiment_path(@experiment), variant: :ghost) %>
    <%= render ButtonComponent.new(label: 'Request suggestion', form_action: suggestion_experiment_path(@experiment), method: :post, variant: :primary) %>
  <% end %>
<% end %>

<% if @command_errors.present? %>
  <div class="command-errors mb-4 rounded-md border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger">
    <%= @command_errors.join(', ') %>
  </div>
<% end %>

<% if @no_suggestion_available %>
  <div class="mb-4">
    <%= render EmptyStateComponent.new(title: 'No suggestion is available',
                                       body: 'The current generation has no organisms to suggest.',
                                       class_name: 'no-suggestion-available',
                                       aria_label: 'No suggestion available') %>
  </div>
<% end %>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <%= render CardComponent.new(title: 'Configuration') do %>
    <dl class="space-y-2">
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-sm text-inkMuted">Population size</dt>
        <dd class="font-data text-sm tabular-nums text-ink"><%= @experiment.configuration.fetch('population_size', '—') %></dd>
      </div>
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-sm text-inkMuted">Status</dt>
        <dd>
          <%= render BadgeComponent.new(text: @experiment.status,
                                        intent: { 'running' => :signal, 'completed' => :good, 'failed' => :danger }.fetch(@experiment.status, :default)) %>
        </dd>
      </div>
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-sm text-inkMuted">Evolution</dt>
        <dd>
          <% if @experiment.ripe_for_evolution? %>
            <%= render BadgeComponent.new(text: 'ready to evolve', intent: :good) %>
          <% else %>
            <%= render BadgeComponent.new(text: 'not yet ripe', intent: :muted) %>
          <% end %>
        </dd>
      </div>
    </dl>
  <% end %>

  <% if @suggestion_log %>
    <%= render CardComponent.new(title: 'Suggested organism', class_name: 'suggested-organism') do %>
      <p class="text-sm text-inkMuted">Organism #<span class="font-data tabular-nums text-ink"><%= @suggestion_log.organism.id %></span> from generation
        <span class="font-data tabular-nums text-ink"><%= @suggestion_log.organism.generation.iteration %></span></p>

      <ul class="mt-3 space-y-1">
        <% @suggestion_log.organism.values.includes(:allele).sort_by(&:name).each do |value| %>
          <li class="text-sm">
            <strong class="text-ink"><%= value.allele.name %>:</strong>
            <span class="font-data tabular-nums text-inkMuted"><%= value.data %></span>
          </li>
        <% end %>
      </ul>

      <p class="mt-3 text-xs text-inkMuted">Suggested at
        <span class="font-data tabular-nums"><%= @suggestion_log.suggested_at %></span></p>

      <% if @suggestion_log.outcome_recorded_at.present? %>
        <p class="recorded-fitness mt-2 font-data text-sm tabular-nums text-good">Recorded fitness: <%= @suggestion_log.fitness_input_value %></p>
      <% end %>

      <div class="report-fitness mt-4 border-t border-line pt-4">
        <%= form_with url: report_experiment_path(@experiment), method: :post do |f| %>
          <div class="flex flex-wrap items-end gap-3">
            <%= render FormFieldComponent.new(input_id: 'fitness_input_value', label: 'Fitness', required: true,
                                              hint: 'The ONE number your infrastructure measured.') do %>
              <%= f.number_field :fitness_input_value, step: 'any', required: true, placeholder: 'e.g. 0.81',
                                 class: FormFieldComponent::INPUT_CLASSES %>
            <% end %>
            <%= render ButtonComponent.new(label: 'Report fitness', type: :submit, variant: :primary) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="mt-4">
  <%= render CardComponent.new(class_name: 'fitness-trend-panel') do %>
    <%= render FitnessTrendComponent.new(experiment: @experiment) %>
  <% end %>
</div>
