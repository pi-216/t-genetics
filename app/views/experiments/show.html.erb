<h1><%= @experiment.name %></h1>

<p>Chromosome: <%= @experiment.chromosome.name %></p>
<p>Population size: <%= @experiment.configuration.fetch('population_size', '—') %></p>
<p>Status: <%= @experiment.status %></p>
<p>Evolution:
  <% if @experiment.ripe_for_evolution? %>
    ready to evolve
  <% else %>
    not yet ripe
  <% end %>
</p>

<%= button_to 'Request suggestion', suggestion_experiment_path(@experiment), method: :post %>

<p><%= link_to 'Generation history', history_experiment_path(@experiment) %></p>

<% if @suggestion_log %>
  <section class="suggested-organism">
    <h2>Suggested organism</h2>
    <p>Organism #<%= @suggestion_log.organism.id %> from generation
      <%= @suggestion_log.organism.generation.iteration %></p>
    <ul>
      <% @suggestion_log.organism.values.includes(:allele).sort_by(&:name).each do |value| %>
        <li><strong><%= value.allele.name %>:</strong> <%= value.data %></li>
      <% end %>
    </ul>
    <p><small>Suggested at <%= @suggestion_log.suggested_at %></small></p>

    <% if @suggestion_log.outcome_recorded_at.present? %>
      <p class="recorded-fitness">Recorded fitness: <%= @suggestion_log.fitness_input_value %></p>
    <% end %>

    <div class="report-fitness">
      <%= form_with url: report_experiment_path(@experiment), method: :post do |f| %>
        <%= f.label :fitness_input_value, 'Fitness' %>
        <%= f.number_field :fitness_input_value, step: 'any', required: true, placeholder: 'e.g. 0.81' %>
        <%= f.submit 'Report fitness' %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @command_errors.present? %>
  <div class="command-errors">
    <p><%= @command_errors.join(', ') %></p>
  </div>
<% end %>
