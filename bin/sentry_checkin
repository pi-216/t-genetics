#!/usr/bin/env bash
# Sentry cron check-in helper (AGENTS.md Sentry pillar; docs/ops/sentry.md).
#
# Usage (from the repo workdir):
#   bin/sentry_checkin <monitor_slug> <start|ok|failed>
#
# Sends a check-in for the named Sentry cron monitor via the Sentry envelope
# endpoint (/api/<project>/envelope/) — the same transport sentry-cli and the
# SDKs use; the plain "cron" HTTP endpoint accepts (202) but silently drops
# check-ins for monitors in this org. The DSN is read from encrypted Rails
# credentials (config/credentials.yml.enc) via a rails runner boot — never
# from env or the repo; ingest host/project are derived from the DSN, so no
# token or org slug is needed at runtime.
#
# No DSN configured => silent no-op (exit 0), so this script is safe on hosts
# that never provisioned Sentry. `start`/`ok`/`failed` share one check-in ID
# (stored in /tmp) so Sentry tracks the run's duration and status.
#
# First check-in for a slug includes monitor_config (upsert) so the monitor
# is created if missing. NOTE (measured 2026-09-12): monitors auto-created via
# the API/envelope land ObjectStatus=disabled on this org (platform behavior —
# the same happened to crawlr's test monitors); they keep accepting check-ins
# only after being enabled once in the Sentry UI (Crons → <monitor> → enable).
# Provision + enable steps: docs/ops/sentry.md.
set -euo pipefail

SLUG="${1:-}"
STATUS="${2:-}"
if [[ -z "$SLUG" || -z "$STATUS" ]]; then
  echo "usage: bin/sentry_checkin <monitor_slug> <start|ok|failed>" >&2
  exit 2
fi

DSN="$(bundle exec rails runner 'print Rails.application.credentials.dig(:sentry, :dsn).to_s' 2>/dev/null || true)"
if [[ -z "$DSN" ]]; then
  echo "sentry: no DSN configured — check-in skipped (${SLUG} ${STATUS})"
  exit 0
fi

# Per-slug monitor schedule/margins (crontab schedule, checkin_margin, max_runtime).
case "$SLUG" in
  tgenetics-dev-worker)  SCHED="0 * * * *";  MARGIN=10; RUNTIME=50;;
  gaas-product-manager)  SCHED="0 9 * * *";  MARGIN=30; RUNTIME=90;;
  gaas-founder-digest)   SCHED="30 8 * * *"; MARGIN=30; RUNTIME=60;;
  *)                     SCHED="";           MARGIN=$((RUNTIME=0));;
esac

ID_FILE="/tmp/tgen-sentry-${SLUG}.id"
case "$STATUS" in
  start)
    ID="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)"
    printf '%s' "$ID" > "$ID_FILE"
    SENTRY_STATUS="in_progress"
    ;;
  ok | failed)
    ID="$(cat "$ID_FILE" 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)"
    rm -f "$ID_FILE"
    if [[ "$STATUS" == "ok" ]]; then
      SENTRY_STATUS="ok"
    else
      SENTRY_STATUS="error"
    fi
    ;;
  *)
    echo "bin/sentry_checkin: bad status '${STATUS}' (start|ok|failed)" >&2
    exit 2
    ;;
esac

exec python3 -c '
import sys, re, json, uuid, datetime, urllib.request
dsn, slug, status, sched, margin, runtime, checkin_id = sys.argv[1:8]
m = re.match(r"^https://([^@]+)@([^/]+)/([0-9]+)$", dsn)
if not m:
    print("sentry: DSN parse failed (unexpected shape)", file=sys.stderr)
    sys.exit(1)
host, project_id = m.group(2), m.group(3)
payload = {"check_in_id": checkin_id, "monitor_slug": slug, "status": status}
if sched:
    payload["monitor_config"] = {
        "schedule": {"type": "crontab", "value": sched},
        "checkin_margin": int(margin), "max_runtime": int(runtime),
        "timezone": "America/New_York",
        "failure_issue_threshold": 1, "recovery_threshold": 1,
    }
item = json.dumps(payload)
envelope = "\n".join([
    json.dumps({"event_id": str(uuid.uuid4()),
                "sent_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z"),
                "dsn": dsn}),
    json.dumps({"type": "check_in", "content_type": "application/json", "length": len(item)}),
    item,
]) + "\n"
req = urllib.request.Request(f"https://{host}/api/{project_id}/envelope/",
    data=envelope.encode(), method="POST",
    headers={"Content-Type": "application/x-sentry-envelope"})
try:
    with urllib.request.urlopen(req, timeout=20) as r:
        print(f"sentry_checkin {slug} {status} -> HTTP {r.status}")
except Exception as e:
    print(f"sentry_checkin {slug} {status} -> ERROR {e}", file=sys.stderr)
    sys.exit(1)
' "$DSN" "$SLUG" "$SENTRY_STATUS" "$SCHED" "$MARGIN" "$RUNTIME" "$ID"