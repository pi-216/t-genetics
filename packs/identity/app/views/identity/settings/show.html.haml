= render PageHeaderComponent.new(title: 'Organization settings',
                                 kicker: 'Workspace',
                                 subtitle: current_user.organization.name)

- if current_user.org_membership.role == Identity::OrgMembership::OWNER_ROLE
  .space-y-4
    = render CardComponent.new(title: 'Member management') do
      %p.text-sm.text-inkMuted Manage who belongs to this organization.

    = render CardComponent.new(title: 'Token management') do
      %p.text-sm.text-inkMuted Manage this organization’s access tokens.

      - if flash[:api_token].present?
        %div{ id: "token_plaintext", class: "mt-4 rounded-md border border-signal bg-signal/10 p-4" }
          %p.text-sm.font-semibold.text-signal Copy this token now — it is shown only once.
          %p{ id: "token_plaintext_value", class: "mt-2 break-all font-data tabular-nums text-ink" }= flash[:api_token]

      - if flash[:alert].present?
        %p.mt-4.text-sm.text-danger= flash[:alert]

      = form_with url: api_tokens_path, scope: :api_token, class: "mt-4" do |form|
        .flex.flex-wrap.gap-3.items-end
          .flex-1
            = render FormFieldComponent.new(input_id: 'api_token_name', label: 'Token name', required: true) do
              = form.text_field :name, required: true, class: FormFieldComponent::INPUT_CLASSES
          = render ButtonComponent.new(label: 'Create token', type: :submit, variant: :primary)

      - if current_user.organization.api_tokens.active.any?
        %ul.mt-4.space-y-1.text-sm.text-inkMuted
          - current_user.organization.api_tokens.active.each do |api_token|
            %li= "#{api_token.name} (created #{api_token.created_at.to_fs(:short)})"