= render PageHeaderComponent.new(title: 'Organization invite',
                                 kicker: 'Workspace',
                                 subtitle: "Share this code with someone you want to join #{current_user.organization.name} as a member.")

= render CardComponent.new(title: 'Invite code') do
  - if @invite_code
    %p.mt-2
      %span.invite-code.inline-block.rounded-md.border.border-line.bg-raised.p-4.font-data.text-2xl.tracking-widest.text-ink
        = @invite_code.code
  - else
    = render EmptyStateComponent.new(title: 'No invite code yet',
                                     body: 'Generate an invite code to let others join your organization.')

  - if @invite_code
    %p.mt-3.text-sm.text-inkMuted Share this code with someone you want to join your organization as a member.

  .mt-4
    = form_with url: organization_invite_code_path, class: "mt-2" do |form|
      = render ButtonComponent.new(label: 'Generate invite code', type: :submit, variant: :primary)