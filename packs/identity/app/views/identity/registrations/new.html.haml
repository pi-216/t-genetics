- if @user.errors.any?
  %div{ id: "error_explanation", class: "mb-4 rounded bg-danger/10 p-3 text-danger" }
    - @user.errors.full_messages.each do |message|
      %p= message

%h1{ class: "text-2xl font-bold" } Create your account

= form_with model: @user, url: register_path, class: "mt-8 space-y-4" do |form|
  %div
    = form.label :email, class: "block text-sm font-medium"
    = form.email_field :email, required: true, class: "mt-1 w-full rounded border border-line bg-surface px-3 py-2 text-ink placeholder:text-inkMuted"
  %div
    = form.label :password, class: "block text-sm font-medium"
    = form.password_field :password, required: true, class: "mt-1 w-full rounded border border-line bg-surface px-3 py-2 text-ink placeholder:text-inkMuted"
  %div
    = form.label :organization_name, "Organization", class: "block text-sm font-medium"
    = form.text_field :organization_name, required: true, class: "mt-1 w-full rounded border border-line bg-surface px-3 py-2 text-ink placeholder:text-inkMuted"
  = form.submit "Create account", class: "inline-flex items-center rounded-md bg-signal px-5.5 py-3 font-data text-caption font-medium tracking-caption text-onSignal"