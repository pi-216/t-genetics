- if @user.errors.any?
  %div{ id: "error_explanation", class: "mb-4 rounded bg-red-900/50 p-3 text-red-200" }
    - @user.errors.full_messages.each do |message|
      %p= message

%h1{ class: "text-2xl font-bold" } Sign in

= form_with model: @user, url: login_path, class: "mt-8 space-y-4" do |form|
  %div
    = form.label :email, class: "block text-sm font-medium"
    = form.email_field :email, required: true, class: "mt-1 w-full rounded border border-teal-700 bg-teal-800/50 px-3 py-2 text-teal-100"
  %div
    = form.label :password, class: "block text-sm font-medium"
    = form.password_field :password, required: true, class: "mt-1 w-full rounded border border-teal-700 bg-teal-800/50 px-3 py-2 text-teal-100"
  = form.submit "Sign in", class: "rounded bg-teal-600 px-4 py-2 font-semibold text-teal-950"