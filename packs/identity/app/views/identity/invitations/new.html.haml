- if @user.errors.any?
  %div{ id: "error_explanation", class: "mb-4 rounded-md border border-danger/30 bg-danger/10 p-3 text-danger" }
    - @user.errors.full_messages.each do |message|
      %p= message

= render PageHeaderComponent.new(title: 'Join an organization',
                                 kicker: 'Identity',
                                 subtitle: 'Use an invite code to join an existing organization.')

= form_with model: @user, url: join_path, class: "mt-6 max-w-md space-y-4" do |form|
  = render FormFieldComponent.new(input_id: 'identity_user_invite_code', label: 'Invite code', required: true) do
    = form.text_field :invite_code, required: true, class: FormFieldComponent::INPUT_CLASSES
  = render FormFieldComponent.new(input_id: 'identity_user_email', label: 'Email', required: true) do
    = form.email_field :email, required: true, class: FormFieldComponent::INPUT_CLASSES
  = render FormFieldComponent.new(input_id: 'identity_user_password', label: 'Password', required: true) do
    = form.password_field :password, required: true, class: FormFieldComponent::INPUT_CLASSES
  = render ButtonComponent.new(label: 'Join', type: :submit, variant: :primary)